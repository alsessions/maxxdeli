{% macro menuItems(items, columns) %}
  {% if columns %}
    <div class="mb-3 grid grid-cols-[minmax(0,1fr)_3.75rem_3.75rem] gap-3 text-right text-xs font-bold uppercase tracking-wide text-amber-300">
      <span></span>
      <span>{{ columns[0] }}</span>
      <span>{{ columns[1] }}</span>
    </div>
  {% endif %}
  <ul class="space-y-4">
    {% for item in items %}
      <li class="grid break-inside-avoid gap-x-3 border-b border-zinc-800/80 pb-4 last:border-0 last:pb-0 {% if columns or item.price2 %}grid-cols-[minmax(0,1fr)_3.75rem_3.75rem]{% else %}grid-cols-[minmax(0,1fr)_auto]{% endif %}">
        <div class="min-w-0">
          <span class="font-extrabold uppercase leading-snug tracking-wide text-zinc-50">{{ item.name }}</span>
          {% if item.description %}
            <p class="mt-1 text-sm leading-snug text-zinc-300">{{ item.description }}</p>
          {% endif %}
        </div>
        <span class="text-right font-extrabold text-amber-300">{{ item.price }}</span>
        {% if columns or item.price2 %}
          <span class="text-right font-extrabold text-amber-300">{{ item.price2 | default("—") }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% macro menuCard(section, showTitle = true) %}
  <section class="rounded-xl border-2 border-amber-500/50 bg-zinc-900/70 p-5 shadow-lg shadow-black/30 md:p-6">
    {% if showTitle %}
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-zinc-700/70 pb-4">
        <div>
          <h3 class="text-2xl font-black uppercase tracking-wide text-zinc-50 md:text-3xl">{{ section.title }}</h3>
          {% if section.subtitle %}<p class="mt-1 font-bold uppercase tracking-wide text-amber-300">{{ section.subtitle }}</p>{% endif %}
        </div>
        {% if section.price %}<p class="text-xl font-black text-amber-300">{{ section.price }}</p>{% endif %}
      </div>
    {% endif %}

    {% if section.groups %}
      <div class="space-y-8">
        {% for group in section.groups %}
          <div>
            <h4 class="mb-3 inline-flex rounded-lg border-2 border-amber-500/50 bg-red-900/80 px-4 py-2 text-lg font-extrabold uppercase tracking-wide text-zinc-50">{{ group.title }}</h4>
            {% if group.description %}<p class="text-sm leading-relaxed text-zinc-300">{{ group.description }}</p>{% endif %}
            {% if group.items %}{{ menuItems(group.items, group.columns) }}{% endif %}
            {% if group.note %}<p class="mt-4 font-bold uppercase tracking-wide text-amber-300">{{ group.note }}</p>{% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      {% if section.wide %}<div class="lg:columns-2 lg:gap-10">{% endif %}
        {{ menuItems(section.items, section.columns) }}
      {% if section.wide %}</div>{% endif %}
    {% endif %}

    {% if section.note %}<p class="mt-5 font-bold uppercase tracking-wide text-amber-300">{{ section.note }}</p>{% endif %}
    {% if section.extras %}
      <ul class="mt-4 flex flex-wrap gap-2">
        {% for extra in section.extras %}
          <li class="rounded-full border border-amber-400/50 bg-black/20 px-3 py-1 text-sm font-bold uppercase text-zinc-100">{{ extra }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endmacro %}

{% set menuGroups = [
  {
    title: "Breakfast",
    id: "breakfast",
    columns: 2,
    sections: [menuSections[0], menuSections[1]]
  },
  {
    title: "Entrées",
    id: "entrees",
    columns: 3,
    sections: [menuSections[3], menuSections[4], menuSections[6], menuSections[9], menuSections[10], menuSections[11], menuSections[12], menuSections[13]]
  },
  {
    title: "Signature Sandwiches",
    id: "signature-sandwiches",
    columns: 1,
    sections: [menuSections[2]]
  },
  {
    title: "Drinks & Beverages",
    id: "drinks-beverages",
    columns: 3,
    sections: [menuSections[5], menuSections[7], menuSections[8]]
  }
] %}

<article class="bg-[#681315]">
  <header class="relative overflow-hidden border-b border-red-800/50">
    <img
      src="/assets/images/maxx-deli-hero.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[center_45%] opacity-40"
      loading="eager"
      eleventy:ignore
    >
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
    <div class="container relative flex min-h-[30rem] max-w-7xl flex-col justify-center py-16 md:min-h-[38rem] md:py-20 lg:min-h-[44rem]">
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-amber-300">Maxx Deli &amp; Shop</p>
      <h1 class="max-w-4xl text-balance text-zinc-50">Menu</h1>
      <p class="mt-5 max-w-2xl text-lg font-medium text-zinc-100 md:text-xl">
        Breakfast, stacked sandwiches, wraps, cheesesteaks, burgers, smoothies, and plenty more.
      </p>
      <nav class="mt-8 flex flex-wrap gap-3" aria-label="Menu sections">
        {% for menuGroup in menuGroups %}
          <a
            href="#{{ menuGroup.id }}"
            class="rounded-full border-2 border-amber-500/60 bg-[#351111]/80 px-4 py-2 text-sm font-bold uppercase tracking-wide text-amber-300 no-underline transition-colors hover:border-amber-300 hover:bg-[#351111] hover:text-amber-200"
          >
            {{ menuGroup.title }}
          </a>
        {% endfor %}
      </nav>
      <div class="mt-6">
        <p class="text-sm font-bold uppercase tracking-wide text-amber-300">Order Delivery</p>
        <div class="mt-3 flex flex-wrap items-center gap-2" aria-label="Delivery providers">
          <a href="#" @click.prevent aria-label="Order with Uber Eats" class="inline-flex h-11 min-w-14 items-center justify-center rounded-lg border-2 border-transparent bg-white px-3 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-300">
            <img src="/providers/ubereats.svg" alt="Uber Eats" class="h-7 w-auto" loading="lazy" eleventy:ignore>
          </a>
          <a href="#" @click.prevent aria-label="Order with Grubhub" class="inline-flex h-11 min-w-20 items-center justify-center rounded-lg border-2 border-transparent bg-white px-3 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-300">
            <img src="/providers/grubhub.svg" alt="Grubhub" class="h-6 w-auto" loading="lazy" eleventy:ignore>
          </a>
          <a href="#" @click.prevent aria-label="Order with DoorDash" class="inline-flex h-11 min-w-14 items-center justify-center rounded-lg border-2 border-transparent bg-white px-3 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-300">
            <img src="/providers/doordash.svg" alt="DoorDash" class="h-7 w-auto" loading="lazy" eleventy:ignore>
          </a>
        </div>
      </div>
      <div class="mt-6">
        <p class="text-sm font-extrabold uppercase tracking-wider text-primary-300">Proudly Serving</p>
        <div class="mt-3 flex flex-wrap items-center gap-3" aria-label="Featured food brands">
          <div class="flex h-16 w-28 items-center justify-center p-1 sm:w-32">
            <img src="/assets/images/logos/cheesecake-factory.webp" alt="The Cheesecake Factory" class="max-h-full w-full object-contain" loading="lazy" eleventy:ignore>
          </div>
          <div class="flex h-16 w-28 items-center justify-center p-1 sm:w-32">
            <img src="/assets/images/logos/chesters.webp" alt="Chester's Chicken To Go" class="max-h-full w-full object-contain" loading="lazy" eleventy:ignore>
          </div>
          <div class="flex h-16 w-28 items-center justify-center p-1 sm:w-32">
            <img src="/assets/images/logos/wingman.webp" alt="Wingman Pizza" class="max-h-full w-full object-contain" loading="lazy" eleventy:ignore>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="container max-w-7xl py-12 md:py-16">
    <div class="space-y-16 md:space-y-20">
      {% for menuGroup in menuGroups %}
        <section id="{{ menuGroup.id }}" class="scroll-mt-6">
          <div class="mb-6 rounded-xl bg-gradient-to-r from-[#c52a30] from-0% via-[#7d161a] via-55% to-[#351111] px-4 py-3 shadow-md shadow-black/35 md:px-5">
            <h2 class="text-3xl font-black uppercase tracking-wide text-amber-200 drop-shadow-md md:text-4xl">{{ menuGroup.title }}</h2>
          </div>

          <div class="grid items-start gap-6 {% if menuGroup.columns == 2 %}lg:grid-cols-2{% elif menuGroup.columns == 3 %}lg:grid-cols-2 xl:grid-cols-3{% endif %}">
            {% for section in menuGroup.sections %}
              {{ menuCard(section, menuGroup.title != "Signature Sandwiches") }}
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  </div>
</article>
