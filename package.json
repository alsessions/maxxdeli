{
  "name": "maxx-deli",
  "version": "1.0.0",
  "description": "The Maxx Deli & Shop website, built with Eleventy, Nunjucks, Tailwind CSS, and Alpine.js",
  "license": "MIT",
  "author": "Maxx Deli & Shop",
  "keywords": [
    "11ty",
    "eleventy",
    "restaurant",
    "deli",
    "nunjucks",
    "tailwindcss",
    "alpinejs"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf ./_site ./.cache",
    "start": "ELEVENTY_ENV=development NODE_ENV=development npm-run-all --parallel watch:*",
    "dev": "npm run start",
    "build": "ELEVENTY_ENV=production NODE_ENV=production npm-run-all --serial build:js build:css build:11ty",
    "watch:11ty": "eleventy --serve --quiet",
    "build:11ty": "eleventy",
    "watch:js": "esbuild ./src/assets/js/main.js --outfile=./_site/assets/js/main.js --bundle --watch --sourcemap",
    "build:js": "esbuild ./src/assets/js/main.js --outfile=./_site/assets/js/main.js --bundle --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --minify",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@alpinejs/collapse": "^3.15.9",
    "@alpinejs/intersect": "^3.15.9",
    "@tailwindcss/cli": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@zachleat/table-saw": "^1.0.7",
    "alpinejs": "^3.15.9",
    "eleventy-plugin-phosphoricons": "^2.0.0",
    "eleventy-plugin-speculation-rules": "^2.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "html-minifier-terser": "^7.2.0",
    "linkedom": "^0.18.12",
    "lite-youtube-embed": "^0.3.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.78.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
